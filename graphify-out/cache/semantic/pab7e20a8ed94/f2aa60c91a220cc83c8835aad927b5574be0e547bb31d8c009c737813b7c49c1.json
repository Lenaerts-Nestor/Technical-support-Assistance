{"nodes": [{"id": "readme", "label": "README.md (Support Hub overview)", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_linked_folder", "label": "Linked folder (data folder chosen on Sync page)", "file_type": "concept", "source_file": "README.md", "source_location": "L7-L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guides, links, case snippets and the calendar are saved into one folder the user picks once, so data stays on the computer and a guide folder is self-contained and movable."}, {"id": "readme_guides_json", "label": "guides.json (list of guides, source of truth)", "file_type": "concept", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_guide_folder", "label": "guides/<name>/ per-guide folder (guide.json, images, projects)", "file_type": "concept", "source_file": "README.md", "source_location": "L12-L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Images and project zips are referenced relative to the guide's own folder so a guide can be moved on its own."}, {"id": "readme_links_json", "label": "links.json (Links page)", "file_type": "concept", "source_file": "README.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_cases_snippets_json", "label": "cases-snippets.json (My texts on Cases page)", "file_type": "concept", "source_file": "README.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_calendar_json", "label": "calendar.json (personal calendar entries)", "file_type": "concept", "source_file": "README.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_nvx_json", "label": "nvx.json (Device API groups, units, saved calls; no passwords)", "file_type": "concept", "source_file": "README.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_organize_folders", "label": "Organize folders (migrate legacy shared-image guides)", "file_type": "concept", "source_file": "README.md", "source_location": "L28-L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only copies, never moves or deletes originals, previews first, and leaves a guide untouched if not all its files can be copied, so it is safe to retry."}, {"id": "readme_calendar_page", "label": "Calendar page (PTO and Other days)", "file_type": "concept", "source_file": "README.md", "source_location": "L37-L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Personal data: it has no Sync card of its own, so it is never part of a Links or Snippets export; only the full backup carries it."}, {"id": "readme_updates", "label": "App updates (check, download, restart and install)", "file_type": "concept", "source_file": "README.md", "source_location": "L47-L64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing installs without a click; only the setup version can replace itself, the portable file can only detect a newer version."}, {"id": "readme_update_token", "label": "Read-only GitHub update token (encrypted by Windows)", "file_type": "concept", "source_file": "README.md", "source_location": "L58-L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The repository is private, so the app reads releases with a fine-grained Contents read-only token pasted once and kept in update-token.bin, never in the repository or the app."}, {"id": "readme_device_api", "label": "Device API page (Postman for Crestron devices, desktop only)", "file_type": "concept", "source_file": "README.md", "source_location": "L66-L109", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A web page cannot do the device login (Cookie, Origin, Referer headers and HttpOnly cookies), so the desktop app does it following the DM NVX API manual."}, {"id": "readme_device_api_changes_gate", "label": "Changes switch (Read only / Changes allowed) and review step", "file_type": "concept", "source_file": "README.md", "source_location": "L92-L102", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Switched off at every start; non-GET calls open a review, run on one unit at a time, and empty objects in a body are warned about because the device deletes an object it is sent empty."}, {"id": "readme_device_api_saved_calls", "label": "Saved calls, folders and Run all (GET only)", "file_type": "concept", "source_file": "README.md", "source_location": "L82-L86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run all and folder play run only GET calls so nothing that changes a device ever runs without a review."}, {"id": "readme_device_api_compare", "label": "Results Compare view (units side by side, differences highlighted)", "file_type": "concept", "source_file": "README.md", "source_location": "L87-L91", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_private_network_restriction", "label": "Private network address restriction (10.x, 172.16-31.x, 192.168.x, 169.254.x)", "file_type": "rationale", "source_file": "README.md", "source_location": "L103-L109", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only private addresses are accepted so the app can never be pointed at the internet; the self-signed certificate is accepted for those requests only."}, {"id": "readme_login_safety", "label": "Login safety rules (no retry on failed login, 10 s timeout, passwords memory-only)", "file_type": "rationale", "source_file": "README.md", "source_location": "L74-L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A failed login stops the run for that unit instead of retrying so a wrong password cannot lock an account; passwords are never saved."}, {"id": "readme_terminal", "label": "Terminal page (SSH consoles with xterm.js, desktop only)", "file_type": "concept", "source_file": "README.md", "source_location": "L111-L142", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Like Crestron Toolbox's text console: one SSH session per unit on port 22, connection made by the desktop app, at most 12 terminals, all closed when the app quits."}, {"id": "readme_terminal_line_editing", "label": "In-page line editing (history, Tab completion from help all)", "file_type": "concept", "source_file": "README.md", "source_location": "L128-L136", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The page redraws the whole line each time so nothing depends on how the unit echoes an erase; history is never saved because a command can hold a password."}, {"id": "readme_terminal_unit_card", "label": "Terminal unit card (hostname, firmware, PUF, Web button)", "file_type": "concept", "source_file": "README.md", "source_location": "L124-L127", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read on a second hidden shell on the same connection so a slow unit never delays what the user types."}, {"id": "readme_terminal_host_keys", "label": "SSH host key trust (accept-new, Trust the new key)", "file_type": "concept", "source_file": "README.md", "source_location": "L137-L139", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_cases_pictures", "label": "Pictures in the Cases editor ([image N] lines, IndexedDB)", "file_type": "concept", "source_file": "README.md", "source_location": "L144-L155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pasted pictures become thumbnails with an [image N] line in the draft; Copy puts pictures into the email for the Salesforce composer, Plain text leaves them out."}, {"id": "readme_sharing", "label": "Sharing on the Sync page (Links, Snippets, Guides, Full backup)", "file_type": "concept", "source_file": "README.md", "source_location": "L157-L166", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_full_backup", "label": "Full backup (.zip of the whole folder)", "file_type": "concept", "source_file": "README.md", "source_location": "L165", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_desktop_app", "label": "Desktop app (Electron, Windows)", "file_type": "concept", "source_file": "README.md", "source_location": "L168-L199", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A window around the built site so every page works as on the web; nothing is sent anywhere and data stays on the computer."}, {"id": "readme_release_files", "label": "Release files table (setup.exe, portable.exe, latest.yml)", "file_type": "concept", "source_file": "README.md", "source_location": "L182-L186", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The setup installer is the one that updates itself; the portable file runs anywhere but cannot update."}, {"id": "readme_unsigned_builds", "label": "Unsigned builds (SmartScreen warning)", "file_type": "concept", "source_file": "README.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_development", "label": "Development commands (dev, lint, test, build)", "file_type": "concept", "source_file